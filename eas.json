{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_RORK_API_BASE_URL": "REPLACE_ME_DEV_API_BASE_URL",
        "EXPO_PUBLIC_WS_URL": "REPLACE_ME_DEV_WS_URL",
        "EXPO_PUBLIC_PROJECT_ID": "REPLACE_ME_EXPO_PROJECT_ID",
        "EXPO_PUBLIC_ROUTING_URL": "REPLACE_ME_DEV_ROUTING_URL",
        "EXPO_PUBLIC_TERMS_URL": "REPLACE_ME_TERMS_URL",
        "EXPO_PUBLIC_PRIVACY_URL": "REPLACE_ME_PRIVACY_URL"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_RORK_API_BASE_URL": "REPLACE_ME_STAGING_API_BASE_URL",
        "EXPO_PUBLIC_WS_URL": "REPLACE_ME_STAGING_WS_URL",
        "EXPO_PUBLIC_PROJECT_ID": "REPLACE_ME_EXPO_PROJECT_ID",
        "EXPO_PUBLIC_ROUTING_URL": "REPLACE_ME_STAGING_ROUTING_URL",
        "EXPO_PUBLIC_TERMS_URL": "REPLACE_ME_TERMS_URL",
        "EXPO_PUBLIC_PRIVACY_URL": "REPLACE_ME_PRIVACY_URL"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_RORK_API_BASE_URL": "REPLACE_ME_PROD_API_BASE_URL",
        "EXPO_PUBLIC_WS_URL": "REPLACE_ME_PROD_WS_URL",
        "EXPO_PUBLIC_PROJECT_ID": "REPLACE_ME_EXPO_PROJECT_ID",
        "EXPO_PUBLIC_ROUTING_URL": "REPLACE_ME_PROD_ROUTING_URL",
        "EXPO_PUBLIC_TERMS_URL": "REPLACE_ME_TERMS_URL",
        "EXPO_PUBLIC_PRIVACY_URL": "REPLACE_ME_PRIVACY_URL"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
