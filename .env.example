# ZBR Courier — build-time environment template
# Copy to .env (gitignored) and fill in real values BEFORE building.
# Expo inlines EXPO_PUBLIC_* into the JS bundle at build/bundling time —
# a production bundle built without them will throw at startup (REPLACE_ME
# and empty-value guards in constants/config.ts).

# --- Required (app refuses to run a production build without these) ---
# Production. For app-side testing use staging instead — it sends no SMS
# (log in with +998900000000 / OTP 123456) and its access tokens expire after
# 60 seconds on purpose, so token refresh is exercised constantly:
#   EXPO_PUBLIC_RORK_API_BASE_URL=https://staging.zbrr.uz
EXPO_PUBLIC_RORK_API_BASE_URL=https://api.example.uz
EXPO_PUBLIC_WS_URL=wss://api.example.uz/ws
EXPO_PUBLIC_TERMS_URL=https://example.uz/terms
EXPO_PUBLIC_PRIVACY_URL=https://app.zbrr.uz/privacy

# --- Optional (safe fallbacks exist) ---
# SockJS fallback endpoint; defaults derived from EXPO_PUBLIC_WS_URL
#EXPO_PUBLIC_WS_SOCKJS_URL=https://api.example.uz/ws
# Self-hosted OSRM for in-app route previews; falls back to straight-line
#EXPO_PUBLIC_ROUTING_URL=https://osrm.example.uz
# Crash report sink; crash reporting is a silent no-op without it
#EXPO_PUBLIC_CRASH_ENDPOINT=https://api.example.uz/api/v1/client-crashes

# --- NO PUSH KEYS BELONG IN THIS FILE ---
# The FCM service-account credentials and the APNs .p8 auth key live on the
# BACKEND, which is what actually sends the notifications. The app only obtains
# a device token and POSTs it to /api/v1/device-tokens.
# The one client-side piece Android needs is google-services.json at the repo
# root (project/app IDs, not a secret) — without it getDevicePushTokenAsync
# throws and Android push is dead. iOS needs no file: the APNs entitlement and
# provisioning profile cover it.

# --- Build-time only (consumed by app.config.ts, not bundled) ---
GOOGLE_MAPS_API_KEY=your-android-maps-sdk-key
# Path override for google-services.json; defaults to ./google-services.json
#GOOGLE_SERVICES_JSON=./google-services.json
