# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native — Continuous Native Generation. android/ and ios/ are regenerated by
# `npx expo prebuild` from app.config.ts + plugins/, and are never committed:
# a stale committed copy silently overrides the config on the next build.
/android
/ios

*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Signing + Firebase secrets — never commit these.
keystore.properties
google-services.json
android/app/google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env
.env.production
